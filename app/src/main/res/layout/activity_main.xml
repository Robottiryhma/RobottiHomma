<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_face"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="OAMK CAMPUS NAVIGATOR"
            android:textColor="#026C96"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <!-- Welcome section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello!"
                android:textColor="#163A5F"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How can I help you today?"
                android:textColor="#52677C"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Menu buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/buttonSpeak"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Speak"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#026C96"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/buttonMap"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Map"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#026C96"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/buttonLanguages"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Languages"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#026C96" />

        </LinearLayout>

        <!-- Footer -->
        /*<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="#026C96"
            android:textSize="13sp"
            android:padding="8dp" />

    </LinearLayout>*/

</FrameLayout>
